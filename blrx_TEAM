--==================== MAP COPY ====================--
local function dumpFullMap()
    notify("Map Copy", "Dumping...")
    local mapData = {Name=game.Name, PlaceId=game.PlaceId, JobId=game.JobId, Objects={}, Scripts={}, LocalScripts={}, ModuleScripts={}}
    local function scan(obj, path)
        path = path or obj.Name
        pcall(function()
            local e = {Class=obj.ClassName, Name=obj.Name, Path=path}
            if obj:IsA("BasePart") then
                e.Position = {obj.Position.X, obj.Position.Y, obj.Position.Z}
                e.Size = {obj.Size.X, obj.Size.Y, obj.Size.Z}
                e.Anchored = obj.Anchored
            end
            table.insert(mapData.Objects, e)
        end)
        for _, c in ipairs(obj:GetChildren()) do scan(c, path.."."..c.Name) end
    end
    scan(Workspace)
    local function dumpScripts(cont, list)
        for _, v in ipairs(cont:GetDescendants()) do
            if v:IsA("Script") or v:IsA("LocalScript") or v:IsA("ModuleScript") then
                local src = "--locked"
                pcall(function()
                    if decompile then src = decompile(v)
                    elseif getscriptbytecode then src = tostring(getscriptbytecode(v)) end
                end)
                table.insert(mapData[list], {Name=v.Name, Class=v.ClassName, Path=v:GetFullName(), Source=src})
            end
        end
    end
    dumpScripts(Workspace, "Scripts")
    dumpScripts(ReplicatedStorage, "ModuleScripts")
    pcall(function() dumpScripts(game:GetService("StarterPlayer"), "LocalScripts") end)
    local json = HttpService:JSONEncode(mapData)
    if writefile then
        local fn = "BLRX_MAP_"..game.PlaceId.."_"..os.time()..".json"
        writefile(fn, json)
        notify("Map Copy", "Saved "..fn)
    else
        print(json:sub(1,4000))
        notify("Map Copy", "Printed")
    end
end

