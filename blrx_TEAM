--==================== UTILS ====================--
local function notify(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "[BLRX_TEAM] "..title,
            Text = text,
            Duration = 4
        })
    end)
    print("[BLRX_TEAM] "..title.." | "..text)
end

local function getClosestPlayer()
    local closest, shortest = nil, AIMBOT_FOV
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            if AIMBOT_TEAM_CHECK and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then continue end
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local head = plr.Character:FindFirstChild("Head")
            if hum and hum.Health > 0 and head then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
                    if dist < shortest then
                        shortest = dist
                        closest = head
                    end
                end
            end
        end
    end
    return closest
end

local function getRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

--==================== ESP ====================--
local function clearESP(plr)
    if ESPObjects[plr] then
        for _, v in pairs(ESPObjects[plr]) do pcall(function() v:Destroy() end) end
        ESPObjects[plr] = nil
    end
end

local function createESP(plr)
    if plr == LocalPlayer then return end
    clearESP(plr)
    local d = {}
    d.box = Drawing.new("Square")
    d.box.Thickness = 1.5
    d.box.Filled = false
    d.box.Visible = false
    d.tracer = Drawing.new("Line")
    d.tracer.Thickness = 1.2
    d.tracer.Visible = false
    d.name = Drawing.new("Text")
    d.name.Size = 15
    d.name.Center = true
    d.name.Outline = true
    d.name.Visible = false
    d.health = Drawing.new("Text")
    d.health.Size = 13
    d.health.Center = true
    d.health.Outline = true
    d.health.Visible = false
    ESPObjects[plr] = d
end

local function updateESP()
    if not ESPEnabled then
        for plr in pairs(ESPObjects) do clearESP(plr) end
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if not ESPObjects[plr] then createESP(plr) end
        local d = ESPObjects[plr]
        local char = plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        if not char or not hum or not root or not head or hum.Health <= 0 then
            d.box.Visible = false
            d.tracer.Visible = false
            d.name.Visible = false
            d.health.Visible = false
            continue
        end
        local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
        local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        local footPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
        local isTeam = plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team
        local col = isTeam and ESP_COLOR_TEAM or ESP_COLOR_ENEMY
        if onScreen then
            local height = math.abs(headPos.Y - footPos.Y)
            local width = height / 2
            if ESP_BOX then
                d.box.Size = Vector2.new(width, height)
                d.box.Position = Vector2.new(pos.X - width/2, headPos.Y)
                d.box.Color = col
                d.box.Visible = true
            else d.box.Visible = false end
            if ESP_TRACER then
                d.tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                d.tracer.To = Vector2.new(pos.X, pos.Y)
                d.tracer.Color = col
                d.tracer.Visible = true
            else d.tracer.Visible = false end
            if ESP_NAME or ESP_DISTANCE then
                local dist = (root.Position - Camera.CFrame.Position).Magnitude
                local txt = ESP_NAME and plr.Name or ""
                if ESP_DISTANCE then txt = txt .. string.format(" [%.0fm]", dist) end
                d.name.Text = txt
                d.name.Position = Vector2.new(pos.X, headPos.Y - 18)
                d.name.Color = col
                d.name.Visible = true
            else d.name.Visible = false end
            if ESP_HEALTH then
                d.health.Text = string.format("%.0f HP", hum.Health)
                d.health.Position = Vector2.new(pos.X, footPos.Y + 4)
                d.health.Color = Color3.fromRGB(255*(1-hum.Health/hum.MaxHealth), 255*(hum.Health/hum.MaxHealth), 40)
                d.health.Visible = true
            else d.health.Visible = false end
        else
            d.box.Visible = false
            d.tracer.Visible = false
            d.name.Visible = false
            d.health.Visible = false
        end
    end
end
