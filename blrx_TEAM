local function destroyDeleteMap()
    local keys = {"map","arena","baseplate","building","house","tycoon","plot","island","lobby","spawn","part","model","wall","floor","roof","tower","base","city","road","car","tree","grass","water","bridge","door","window","furniture","chair","table","bed","car","vehicle","plane","boat"}
    for _, obj in ipairs(Workspace:GetChildren()) do
        local low = string.lower(obj.Name)
        for _, k in ipairs(keys) do
            if string.find(low, k) then pcall(function() obj:Destroy() end) break end
        end
    end
    notify("Destroy", "Named objects deleted")
end

local function destroyKillPlayers()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            pcall(function()
                plr.Character:BreakJoints()
